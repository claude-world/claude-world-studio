# Claude World Studio Configuration
# Copy to .env and fill in your values. Loaded by the server (dotenv).
#
# NOTE: Runtime settings — social tokens, quality-gate scores, language, theme —
# live in the SQLite settings store, NOT here. Configure them via the Web UI
# Settings page or `studio settings set`.

# ─── Server ───
# Port the server listens on (default: 3001)
# PORT=3001
# Host the server binds to (default: 127.0.0.1)
# HOST=127.0.0.1
# Log verbosity: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# ─── Data ───
# Override where the SQLite DB and user data are stored
# (default: <repo>/data for a git checkout; OS user-data dir for global installs)
# STUDIO_USER_DATA_PATH=/path/to/data

# ─── Workspace ───
# Default workspace for new sessions (default: current directory)
# DEFAULT_WORKSPACE=/path/to/your/workspace

# ─── MCP Servers ───
# All optional — if uvx is installed, Studio auto-detects MCP servers with zero
# config. These env vars are fallbacks when the corresponding DB setting is empty.

# trend-pulse: real-time trends from 20 sources (zero auth needed)
# TREND_PULSE_PYTHON=/path/to/trend-pulse/.venv/bin/python

# cf-browser: Cloudflare Browser Rendering for JS pages
# CF_BROWSER_PYTHON=/path/to/cf-browser/mcp-server/.venv/bin/python
# cf-api mode credentials (recommended — simpler setup)
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=your-cloudflare-api-token
# worker mode (requires deploying a Cloudflare Worker first)
# CF_BROWSER_URL=https://your-cf-browser.workers.dev
# CF_BROWSER_API_KEY=your-api-key

# notebooklm: Google NotebookLM research + podcast/slides/video
# NOTEBOOKLM_SERVER_PATH=/path/to/notebooklm-skill/mcp-server/server.py
