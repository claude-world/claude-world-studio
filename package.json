{
  "name": "@claude-world/studio",
  "version": "2.3.0",
  "type": "module",
  "description": "Claude World Studio - Trend Discovery to Content Publishing Pipeline",
  "main": "electron/main.cjs",
  "bin": {
    "claude-world-studio": "bin/cli.js",
    "studio": "bin/cli.js",
    "setup-mcp": "bin/setup-mcp.sh"
  },
  "files": [
    "bin/",
    "client/",
    "server/",
    "dist/",
    ".claude/skills/",
    "scripts/electron-build.cjs",
    "scripts/ensure-native-abi.cjs",
    "electron/",
    "postcss.config.js",
    "tsconfig.json",
    "vite.config.ts",
    ".nvmrc",
    ".env.example"
  ],
  "keywords": [
    "claude",
    "ai",
    "agent",
    "threads",
    "social-media",
    "trend-analysis",
    "mcp",
    "anthropic"
  ],
  "author": "Claude World <hello@claude-world.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claude-world/claude-world-studio.git"
  },
  "homepage": "https://github.com/claude-world/claude-world-studio",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite --port 5173",
    "predev": "node scripts/ensure-native-abi.cjs",
    "pretest": "node scripts/ensure-native-abi.cjs",
    "prestart": "node scripts/ensure-native-abi.cjs",
    "postinstall": "node scripts/ensure-native-abi.cjs",
    "prepublishOnly": "npm run build",
    "start": "tsx server/server.ts",
    "build": "vite build",
    "build:server": "node scripts/build-server.cjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && npm run build:server && node scripts/electron-build.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml,css}\"",
    "test": "node --import tsx --test test/*.test.ts",
    "test:desktop-smoke": "node scripts/desktop-smoke.cjs",
    "test:cli": "node bin/cli.js help > /dev/null",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.claude-world.studio",
    "productName": "Claude World Studio",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "package.json",
      "server-dist/**",
      "dist/**",
      ".claude/skills/**",
      "node_modules/**"
    ],
    "electronVersion": "44.9.2",
    "electronUpdaterCompatibility": ">=2.16",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "Wang LongWei (QJX3775S8M)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "files": [
      ".claude/skills/**/*",
      "electron/**/*",
      "server-dist/**/*",
      "dist/index.html",
      "dist/assets/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/sdk/**/*",
      "!node_modules/@babel/**/*",
      "!node_modules/@esbuild/**/*",
      "!node_modules/@opentelemetry/**/*",
      "!node_modules/@stablelib/**/*",
      "!node_modules/dotenv/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/fast-sha256/**/*",
      "!node_modules/fsevents/**/*",
      "!node_modules/json-schema-to-ts/**/*",
      "!node_modules/node-cron/**/*",
      "!node_modules/standardwebhooks/**/*",
      "!node_modules/ts-algebra/**/*",
      "!node_modules/tsx/**/*",
      "!node_modules/uuid/**/*",
      "!node_modules/ws/**/*",
      "!node_modules/better-sqlite3/bin/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/obj.target/**/*",
      "!node_modules/better-sqlite3/build/Release/sqlite3.a",
      "!node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "claude-world",
        "repo": "claude-world-studio",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "postcss-selector-parser": "^7.1.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.305",
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-use-websocket": "^4.13.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
